<?xml version="1.0" encoding="utf-8"?>
<!--
    FixBid launcher foreground — "FIXBID" word-mark drawn as bold block letters.
    All glyphs are built from axis-aligned rectangles plus, for X only, two
    filled parallelograms (real diagonals). No curves means the icon stays
    crisp at every density and on every device icon mask.

    Layout:
      glyph cell        = 8 wide × 22 tall
      stroke thickness  = 3
      gap between cells = 2
      total word width  = 6*8 + 5*2 = 58
      first cell starts at x = 25  (centres the word in the 108 viewport)
      glyph top         = 43, bottom = 65  (vertically centred)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- F : x = 25..33 — left bar + top bar + mid bar -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="
            M 25,43 h 3 v 22 h -3 z
            M 25,43 h 8 v 3 h -8 z
            M 25,52 h 6 v 3 h -6 z" />

    <!-- I : x = 35..43 — top cap + middle bar + bottom cap -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="
            M 35,43 h 8 v 3 h -8 z
            M 37.5,46 h 3 v 16 h -3 z
            M 35,62 h 8 v 3 h -8 z" />

    <!-- X : x = 45..53 — two real diagonals (parallelograms drawn with lineTo) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="
            M 45,43 l 3,0 l 8,22 l -3,0 z
            M 50,43 l 3,0 l -8,22 l -3,0 z" />

    <!-- B : x = 55..63 — left bar + 3 horizontals + right bars on the two lobes -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="
            M 55,43 h 3 v 22 h -3 z
            M 55,43 h 6 v 3 h -6 z
            M 55,52.5 h 6 v 3 h -6 z
            M 55,62 h 6 v 3 h -6 z
            M 60,46 h 3 v 6.5 h -3 z
            M 60,55.5 h 3 v 6.5 h -3 z" />

    <!-- I : x = 65..73 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="
            M 65,43 h 8 v 3 h -8 z
            M 67.5,46 h 3 v 16 h -3 z
            M 65,62 h 8 v 3 h -8 z" />

    <!-- D : x = 75..83 — left bar + top cap + bottom cap + right bar (full height) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="
            M 75,43 h 3 v 22 h -3 z
            M 75,43 h 6 v 3 h -6 z
            M 75,62 h 6 v 3 h -6 z
            M 80,46 h 3 v 16 h -3 z" />
</vector>
