<?xml version="1.0" encoding="utf-8"?>
<!--
    FixBid status-bar notification icon. Android requires this asset to be
    pure white (and transparent) — the platform tints it with the channel /
    notification accent colour automatically. Anything else just shows up as
    a white blob.

    Shape mirrors the launcher: a stylised wrench (spanner). Drawn at 24×24
    (the canonical notification icon size) with the silhouette inset slightly
    so it doesn't touch the edges.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <group
        android:translateX="12"
        android:translateY="12">
        <group android:rotation="-45">

            <!-- Open-end head -->
            <path
                android:fillColor="#FFFFFFFF"
                android:fillType="evenOdd"
                android:pathData="
                    M -7.5,-3.5
                    a 3.8,3.8 0 1 1 0,7
                    a 3.8,3.8 0 1 1 0,-7
                    Z
                    M -10,-2
                    L -5.6,-2
                    L -5.6,2
                    L -10,2
                    Z" />

            <!-- Handle -->
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="
                    M -4,-1.8
                    L 7.5,-1.8
                    A 1.8,1.8 0 0 1 9.3,0
                    A 1.8,1.8 0 0 1 7.5,1.8
                    L -4,1.8
                    Z" />

            <!-- Box-end head -->
            <path
                android:fillColor="#FFFFFFFF"
                android:fillType="evenOdd"
                android:pathData="
                    M 9.3,-3.5
                    a 3.8,3.8 0 1 1 0,7
                    a 3.8,3.8 0 1 1 0,-7
                    Z
                    M 9.3,-1.8
                    a 1.8,1.8 0 1 0 0,3.6
                    a 1.8,1.8 0 1 0 0,-3.6
                    Z" />
        </group>
    </group>
</vector>
